# Shared paths for dbt and MetricFlow CLIs, relative to the repo root (no secrets here).
# Usage from the repo root: uv run --env-file dbt.env dbt build
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt
CFPB_DUCKDB_PATH=data/warehouse/cfpb.duckdb
CFPB_RAW_PARQUET=data/warehouse/raw/complaints.parquet
CFPB_SNAPSHOT_JSON=data/warehouse/raw/snapshot.json
CFPB_API_PARQUET=data/warehouse/raw/api_complaints.parquet
CFPB_API_PULL_DAYS=data/warehouse/raw/api_pull_days.parquet
