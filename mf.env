# MetricFlow reads the warehouse through the read-only dbt target (dbt/profiles.yml), so an
# open app, notebook or eval never blocks a query. dbt build needs read-write: don't add this
# to dbt.env. Usage from the repo root: uv run --env-file dbt.env --env-file mf.env mf query ...
CFPB_DBT_TARGET=readonly
